# CALLSHEET Production Environment Variables
# Copy to .env.local and fill in values before deployment.
# CH-CS-014 W9 AC-34

# ─── Database ────────────────────────────────────────────────────────
# REQUIRED. Supabase PostgreSQL connection string.
# Source: Supabase project dashboard → Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres

# ─── Authentication ──────────────────────────────────────────────────
# REQUIRED. Secret for Better Auth session signing. Min 32 characters.
# Source: Generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# REQUIRED. Canonical URL of the application (no trailing slash).
# Source: Vercel project dashboard → Settings → Domains
BETTER_AUTH_URL=https://callsheet.co.uk

# ─── Email ───────────────────────────────────────────────────────────
# REQUIRED. Resend API key for transactional email.
# Source: Resend dashboard → API Keys
RESEND_API_KEY=

# REQUIRED. Verified sender domain for outbound email.
# Source: Resend dashboard → Domains
RESEND_FROM_DOMAIN=callsheet.co.uk

# ─── Payments ────────────────────────────────────────────────────────
# REQUIRED. Paddle API key for subscription management.
# Source: Paddle dashboard → Developer Tools → Authentication
PADDLE_API_KEY=

# REQUIRED. Paddle webhook secret for verifying webhook signatures.
# Source: Paddle dashboard → Developer Tools → Notifications → Webhook secret
PADDLE_WEBHOOK_SECRET=

# REQUIRED. Paddle environment — "production" for live, "sandbox" for testing.
PADDLE_ENVIRONMENT=production

# ─── Storage ─────────────────────────────────────────────────────────
# REQUIRED. Cloudflare R2 credentials for media storage.
# Source: Cloudflare dashboard → R2 → Manage R2 API Tokens
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=callsheet-media
R2_ACCOUNT_ID=
R2_PUBLIC_URL=

# ─── Companies House ─────────────────────────────────────────────────
# REQUIRED. API key for verification/claim evaluation.
# Source: https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=

# ─── Deployment ──────────────────────────────────────────────────────
# Optional. Set to "true" only for E2E test environments. NEVER in production.
# E2E_TEST_MODE=false

# Optional. Vercel deployment token (used by CI, not by app at runtime).
# Source: Vercel dashboard → Settings → Tokens
# VERCEL_TOKEN=
