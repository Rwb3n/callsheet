    "better-auth": "^1.4.18",
    "drizzle-orm": "^0.45.1",
    "next": "^16.1.6",
    "pg": "^8.18.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "resend": "^6.9.2",
    "zod": "^4.3.6"
  },
